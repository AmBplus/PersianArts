{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "docs/motion/brief.schema.json",
  "title": "persian-arts intake brief",
  "description": "Written by /persian-arts intake to media/briefs-local/<label>/brief.json (git-ignored). Spec: docs/motion/INTAKE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "label",
    "goal",
    "language",
    "duration_s",
    "ratios",
    "genre",
    "character",
    "logo",
    "images",
    "ideas",
    "copy",
    "music",
    "source",
    "assumptions"
  ],
  "properties": {
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Project label; never the client's real name."
    },
    "language": {
      "type": "string",
      "enum": [
        "fa",
        "en",
        "ar"
      ],
      "default": "fa"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "desiredAction"
      ],
      "description": "First-class aim of the film. Every plan, scene and review must trace back to objective and desiredAction.",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 3,
          "description": "One sentence: what the film must achieve (e.g. drive admissions registration, explain a product, announce an event)."
        },
        "audience": {
          "type": "string",
          "minLength": 3,
          "description": "Who it is for."
        },
        "desiredAction": {
          "type": "string",
          "minLength": 3,
          "description": "What the viewer should do after watching, with the CTA text."
        },
        "successSignal": {
          "type": "string",
          "minLength": 3,
          "description": "How we would know it worked (clicks to a URL, QR scans, recall of 3 claims)."
        },
        "tone": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Three adjectives."
        },
        "mustSay": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          },
          "description": "Up to 5 claims/messages."
        },
        "mustNotSay": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "duration_s": {
      "type": "number",
      "minimum": 5,
      "maximum": 180,
      "default": 30
    },
    "short_cut_s": {
      "type": "number",
      "minimum": 5,
      "maximum": 30,
      "default": 12
    },
    "ratios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "9x16",
          "1x1",
          "4x5",
          "16x9"
        ]
      },
      "default": [
        "9x16",
        "1x1",
        "4x5",
        "16x9"
      ]
    },
    "master_ratio": {
      "type": "string",
      "enum": [
        "9x16",
        "1x1",
        "4x5",
        "16x9"
      ],
      "default": "9x16"
    },
    "genre": {
      "type": "string",
      "enum": [
        "ad",
        "edu",
        "story",
        "explainer",
        "event",
        "social"
      ]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "description": "e.g. person, mascot, plain object (pencil)"
        }
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "none",
            "pending",
            "svg",
            "raster",
            "vectorize-approved",
            "vectorized"
          ]
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "display"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "display": {
            "type": "string",
            "enum": [
              "browser-mockup",
              "phone-mockup",
              "parallax",
              "collage-cards",
              "full-bleed-push",
              "device-frames",
              "split-reveal",
              "polaroid-timeline"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "images_pending": {
      "type": "boolean",
      "default": false,
      "description": "User said they have images that have not arrived yet."
    },
    "ideas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wanted"
      ],
      "properties": {
        "wanted": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "provided",
            "drafted-not-native-reviewed",
            "pending"
          ]
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mood"
      ],
      "properties": {
        "mood": {
          "type": "string"
        },
        "bpm_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "track": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "rounds"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "parsed-complete",
            "asked",
            "delegated"
          ]
        },
        "rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "client": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
