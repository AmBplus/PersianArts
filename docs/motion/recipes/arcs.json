     "weight": 1.3,
     "build_s": 1.2,
     "hold_min_s": 0.6,
     "transition_into_next": "wipe ending on the bar",
     "sound_hit": "whoosh 5 frames before the bar",
     "note": "one idea per step"
    },
    {
     "role": "step 2: second reveal",
     "weight": 1.3,
     "build_s": 1.2,
     "hold_min_s": 0.6,
     "transition_into_next": "wipe ending on the bar",
     "sound_hit": "whoosh 5 frames before the bar",
     "note": ""
