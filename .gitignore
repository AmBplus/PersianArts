media/film-v2-local/**/*.flac
media/film-v2-local/**/*.m4a
media/film-v2-local/**/*.zip
media/film-v2-local/**/*.mp4

# film versions: every new render/mix goes to media/film-versions/<film>/<version>/ (see media/film-versions/README.md)
# Whole version folders are ignored (mp4/jpg/wav/json/txt alike) so test versions never enter git; only the README is tracked.
# Promoting a version to git is a manual, later decision (git add -f or a rule change).
media/film-versions/**
!media/film-versions/README.md
media/film-v2-local/**/*.mov
media/film-v2-local/**/*.webm
media/film-v2-local/**/*.jpg
media/film-v2-local/**/*.png

media/briefs-local/**
work/persian/src/workbench/public/uni-local/

# client/institution confidential terms (local only)
contracts/confidential-terms.local.txt

# local tool state and generated artifacts (added by architecture/scan worker)
.mimosa/
.playwright-mcp/
work/persian/_bench/bundle/
media/_contact_sheets/
.remotion/
work/persian/src/workbench/public/conf-local/
work/persian/src/film/conference/copy-map-conference.json

# sound kit (tracked, curated, <= 2 MB per file): re-include audio under sound/library/kit/ (must stay after the sound/library/** rules above)
!sound/library/kit/
!sound/library/kit/**/
!sound/library/kit/**/*.ogg
!sound/library/kit/**/*.opus
!sound/library/kit/**/*.mp3

# asset compressor originals
_orig/
**/assets.lock.json

# finished outputs: one folder (see output/README.md; only README.md is tracked)
output/**
!output/README.md

# viditor reference media (derived data lives in docs/motion/knowledge)
work/viditor-reference/assets/**

# vault: encrypted client archives only; own compressed finals under deliver/
!vault/
vault/*
!vault/*.tar.enc
!deliver/
!deliver/*.mp4
!.env.example
!work/persian/.freesound.env.example
!work/persian/.jamendo.env.example
