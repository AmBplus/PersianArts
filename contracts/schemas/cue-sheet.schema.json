{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/cue-sheet.schema.json",
  "title": "cue sheet (films/<slug>/cues.json, or a version's cues file)",
  "type": "object",
  "required": ["film", "bpm", "cues"],
  "additionalProperties": false,
  "properties": {
    "film": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": ["string", "null"]},
    "bpm": {"type": "number", "minimum": 30, "maximum": 300},
    "t0_s": {"type": "number", "minimum": 0},
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "gain_db"],
        "additionalProperties": false,
        "anyOf": [{"required": ["beat"]}, {"required": ["abs_s"]}],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
          "role": {"enum": ["anticipation", "hit", "ring", "tail", "transition", "ambience"]},
          "beat": {"type": "number", "minimum": 0, "description": "beat index from T0"},
          "abs_s": {"type": "number", "minimum": 0, "description": "absolute film time in seconds"},
          "file": {"type": "string", "description": "path relative to repo root"},
          "catalogue_id": {"type": "string", "description": "sound catalogue id from sound/library"},
          "gain_db": {"type": "number", "minimum": -60, "maximum": 12},
          "trim_s": {"type": "number", "minimum": 0},
          "fade_in_s": {"type": "number", "minimum": 0},
          "fade_out_s": {"type": "number", "minimum": 0},
          "event": {"type": "string"}
        },
        "anyOf": [{"required": ["file"]}, {"required": ["catalogue_id"]}]
      }
    }
  }
}
