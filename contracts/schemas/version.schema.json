{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/version.schema.json",
  "title": "version manifest (media/film-versions/<film>/<version>/VERSION.json)",
  "type": "object",
  "required": ["film", "version", "date", "source_commit", "bpm", "t0_s", "ratios", "outputs", "status", "promoted", "owner_score", "notes"],
  "additionalProperties": false,
  "properties": {
    "metrics": {"type": "object", "description": "per-version measurements (rule 14): time marks, audio-check, loop-check, pacing with --cuts/--track, gates, quality notes"},
    "film": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^v[0-9]+(-[a-z0-9]+)*$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_commit": {"type": "string", "pattern": "^([0-9a-f]{7,40}|unknown)$"},
    "bpm": {"type": "number", "minimum": 30, "maximum": 300},
    "t0_s": {"type": "number", "minimum": 0},
    "track": {
      "type": ["object", "null"],
      "required": ["slug", "path", "t0_s"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string"},
        "path": {"type": "string"},
        "t0_s": {"type": "number", "minimum": 0}
      }
    },
    "cues_file": {"type": ["string", "null"]},
    "ratios": {"type": "array", "minItems": 1, "items": {"enum": ["9x16", "4x5", "1x1", "16x9"]}},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "kind", "ratio", "width", "height", "pix_fmt", "fps", "duration_s", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "description": "relative to the version folder"},
          "kind": {"enum": ["silent", "mixed", "preview", "still"]},
          "ratio": {"enum": ["9x16", "4x5", "1x1", "16x9"]},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "pix_fmt": {"type": "string"},
          "color_range": {"enum": ["tv", "pc", "unknown"]},
          "fps": {"type": "number", "minimum": 1},
          "duration_s": {"type": "number", "minimum": 0},
          "nb_frames": {"type": "integer", "minimum": 0},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "verify": {
      "type": ["object", "null"],
      "required": ["integrated_lufs", "true_peak_dbtp", "film_dur_s", "file_dur_s"],
      "properties": {
        "integrated_lufs": {"type": "number"},
        "true_peak_dbtp": {"type": "number"},
        "film_dur_s": {"type": "number"},
        "file_dur_s": {"type": "number"},
        "cues_total": {"type": "integer", "minimum": 0},
        "file": {"type": "string", "description": "verify.json next to VERSION.json"}
      }
    },
    "status": {"enum": ["test", "candidate", "promoted", "legacy"]},
    "promoted": {"type": "boolean"},
    "owner_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "notes": {"type": "string"},
    "render_report": {"type": ["string", "null"], "description": "render-report.json next to VERSION.json"},
    "render_txt": {"type": ["string", "null"], "description": "render.txt next to VERSION.json"},
    "legacy_fields": {"type": "object", "description": "old keys kept verbatim when migrating (BPM, T0_S, silent_render, ...)"}
  }
}
