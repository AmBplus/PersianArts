{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/decision.schema.json",
  "title": "decision line (one JSON object per line in docs/motion/DECISIONS.jsonl)",
  "type": "object",
  "required": ["date", "area", "decision", "evidence", "status", "owner_approved"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^D-[0-9]{8}-[0-9]{2}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "area": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "decision": {"type": "string", "minLength": 1},
    "why": {"type": "string"},
    "evidence": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "accepted", "confirmed", "rejected", "superseded"]},
    "owner_approved": {"type": "boolean"},
    "owner_note": {"type": "string"},
    "adr": {"type": "string"},
    "superseded_by": {"type": "string"}
  }
}
