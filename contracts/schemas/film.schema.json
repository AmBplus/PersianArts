{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/film.schema.json",
  "title": "film manifest (films/<slug>/film.json)",
  "type": "object",
  "required": ["slug", "title", "status", "ratios", "fps", "duration_s", "bpm", "scenes", "versions"],
  "additionalProperties": false,
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "archived"]},
    "ratios": {"type": "array", "minItems": 1, "items": {"enum": ["9x16", "4x5", "1x1", "16x9"]}},
    "fps": {"enum": [24, 25, 30, 50, 60]},
    "duration_s": {"type": "number", "minimum": 0.1},
    "bpm": {"type": "number", "minimum": 30, "maximum": 300},
    "t0_s": {"type": "number", "minimum": 0},
    "track": {"type": ["string", "null"], "description": "track slug (sound/library/bgm/<slug>.music.json), or null"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "file": {"type": "string"}}
      }
    },
    "copy_tokens_source": {"type": ["string", "null"], "description": "path to the literal text source; null if text is inline in scenes"},
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {"type": "string"},
        "fonts": {"type": "array", "items": {"type": "string"}},
        "images": {"type": "array", "items": {"type": "string"}},
        "sounds": {"type": "array", "items": {"type": "string"}},
        "licences": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cues": {"type": ["string", "null"], "description": "path to cues.json (cue-sheet schema)"},
    "versions": {"type": "string", "description": "path to the version folder or versions.json"},
    "notes": {"type": "string"}
  }
}
